#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&soft_off { hold-time-ms = <2000>; };

/ {
    behaviors {
        td_shift_caps: td_shift_caps {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Shift/Caps Lock Tap Dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;
        };

        // Acentos: pensados para o layout ABNT2 (Portugues Brasil) no sistema
        m_a_til: m_a_til {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <10>;
            bindings = <&macro_tap &kp SQT &kp A>;   // ABNT2: tecla do ' e o til morto
        };

        m_c_cedilha: m_c_cedilha {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <10>;
            bindings = <&macro_tap &kp SEMI>;        // ABNT2: tecla do ; ja e o c cedilha
        };

        m_e_agudo: m_e_agudo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <10>;
            bindings = <&macro_tap &kp LBKT &kp E>;  // ABNT2: tecla do [ e o agudo morto
        };

        td_a: td_a {
            compatible = "zmk,behavior-tap-dance";
            display-name = "A ou A til";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp A>, <&m_a_til>;
        };

        td_c: td_c {
            compatible = "zmk,behavior-tap-dance";
            display-name = "C ou C cedilha";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp C>, <&m_c_cedilha>;
        };

        td_e: td_e {
            compatible = "zmk,behavior-tap-dance";
            display-name = "E ou E agudo";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp E>, <&m_e_agudo>;
        };

        m_u_agudo: m_u_agudo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <10>;
            bindings = <&macro_tap &kp LBKT &kp U>;  // ABNT2: agudo morto + u
        };

        m_o_til: m_o_til {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <10>;
            bindings = <&macro_tap &kp SQT &kp O>;   // ABNT2: til morto + o
        };

        td_u: td_u {
            compatible = "zmk,behavior-tap-dance";
            display-name = "U ou U agudo";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp U>, <&m_u_agudo>;
        };

        td_o: td_o {
            compatible = "zmk,behavior-tap-dance";
            display-name = "O ou O til";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp O>, <&m_o_til>;
        };

        td_barra: td_barra {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Barra ou Interrogacao";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp INT1>, <&kp LS(INT1)>;  // ABNT2: tecla / e Shift+/ = ?
        };

        bspc_del: bspc_del {
            compatible = "zmk,behavior-mod-morph";
            display-name = "Backspace ou Delete";
            #binding-cells = <0>;
            bindings = <&kp BSPC>, <&kp DEL>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };

        rsr_trans: rsr_trans {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <0>;
        };
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <1 15 29>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            bindings = <
&kp TAB         &kp Q  &kp W  &td_e     &kp R         &kp T                             &kp UP                &kp Y      &td_u  &kp I      &td_o    &kp P     &bspc_del
&td_shift_caps  &td_a  &kp S  &kp D     &kp F         &kp G                   &kp LEFT  &kp ENTER  &kp RIGHT  &kp H      &kp J  &kp K      &kp L    &kp SEMI  &kp SQT
&kp LCTRL       &kp Z  &kp X  &td_c     &kp V         &kp B      &kp SPACE              &kp DOWN              &kp N      &kp M  &kp COMMA  &kp DOT  &td_barra &kp ESC
                              &kp LGUI  &kp LEFT_ALT  &lt 1 SPACE                                             &lt 3 ENTER  &mo 2  &kp RALT
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        lower_layer {
            display-name = "NUMBER";
            bindings = <
&trans  &kp N1           &kp N2          &kp N3        &kp N4        &kp N5                                         &trans                           &kp N6           &kp N7           &kp N8           &kp N9           &kp N0    &kp BSPC
&trans  &none            &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3                   &trans          &trans          &trans           &kp LEFT         &kp DOWN         &kp UP           &kp RIGHT        &kp HOME  &kp PG_UP
&trans  &rgb_ug RGB_OFF  &rgb_ug RGB_ON  &trans        &trans        &rgb_ug RGB_EFF  &kp C_MUTE                    &trans                           &rgb_ug RGB_EFR  &rgb_ug RGB_SPI  &rgb_ug RGB_BRI  &rgb_ug RGB_BRD  &kp END   &kp PG_DN
                                         &trans        &trans        &trans                                                                          &kp INS          &kp DEL          &trans
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        raise_layer {
            display-name = "SYMBOL";
            bindings = <
&trans  &kp EXCL      &kp AT        &kp HASH   &kp DLLR   &kp PRCNT                            &trans                           &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR  &kp RPAR  &kp BSPC
&trans  &bt BT_CLR    &none         &none      &none      &none                &trans          &trans          &trans           &kp MINUS  &kp EQUAL  &kp LBKT   &kp RBKT  &kp BSLH  &kp GRAVE
&trans  &out OUT_USB  &out OUT_BLE  &none      &none      &none      &trans                    &trans                           &kp UNDER  &kp PLUS   &kp LBRC   &kp RBRC  &kp PIPE  &kp TILDE
                                    &trans     &trans     &kp SPACE                                                             &kp RET    &trans     &trans
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        layer_3 {
            display-name = "Fn";
            bindings = <
&studio_unlock  &kp F1      &kp F2     &kp F3       &kp F4     &kp F5                                  &trans                           &kp F6       &kp F7     &kp F8       &kp F9      &kp F10          &kp F11
&trans          &trans      &none      &none        &none      &none                   &trans          &trans          &trans           &bootloader  &none      &none        &none       &kp PRINTSCREEN  &kp F12
&trans          &sys_reset  &trans     &bootloader  &trans     &none     &kp C_MUTE                    &trans                           &trans       &trans     &bootloader  &sys_reset  &kp SCROLLLOCK   &kp PAUSE_BREAK
                                       &trans       &trans     &trans                                                                   &trans       &trans     &trans
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };
    };
};
